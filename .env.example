# Signal Leads — every variable is optional for local development.
# With none set, the app runs on an embedded Postgres (.data/pglite) with the
# Evergreen Roofing demo, deterministic dev agents, and simulated messaging.

APP_URL=http://localhost:3000
SESSION_SECRET=                      # 32+ chars, required in production

# Database (Supabase Postgres connection string). Unset = embedded PGlite.
DATABASE_URL=

# Supabase Auth (enables email/password sign-in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only — never expose to the browser
DEMO_MODE=                           # "true" to allow demo sign-in in production

# AI
ANTHROPIC_API_KEY=                   # enables Claude; unset = dev heuristics
SIGNAL_AI_PROVIDER=                  # "dev" forces heuristics even with a key
VOYAGE_API_KEY=                      # semantic embeddings for the knowledge base

# Messaging
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Automation
N8N_WEBHOOK_SECRET=
N8N_OUTBOUND_WEBHOOK_URL=
CRON_SECRET=                         # bearer token for /api/jobs/follow-ups
